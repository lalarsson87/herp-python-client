# HERP API Configuration
# Get your token from: https://app.herp.cloud/settings/api
HERP_API_TOKEN=your_herp_api_token_here
HERP_BASE_URL=https://public-api.herp.cloud/hire/public

# Notion API Configuration (optional, for Notion integration)
# Get your token from: https://www.notion.so/my-integrations
NOTION_API_TOKEN=your_notion_token_here
NOTION_DATABASE_ID=your_database_id_here

# Development Settings
LOG_LEVEL=DEBUG
DEVELOPMENT=1

# Python Settings
PYTHONPATH=./src
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Rate Limiting (optional, defaults shown)
# HERP_RATE_LIMIT=100
# HERP_TIMEOUT=30

# Cache Settings (optional)
# CACHE_ENABLED=1
# CACHE_TTL=300

# Testing (optional)
# RUN_INTEGRATION_TESTS=0
# TEST_CANDIDACY_ID=test_candidacy_id
