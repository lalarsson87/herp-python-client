# HERP API Configuration
HERP_API_KEY=your-herp-api-key-here
HERP_API_BASE_URL=https://public-api.herp.cloud/hire/public

# Notion API Configuration
NOTION_API_KEY=your-notion-api-key-here
NOTION_CANDIDATES_DB_ID=your-notion-database-id-here

# PostgreSQL (for local testing)
POSTGRES_USER=herp_test
POSTGRES_PASSWORD=herp_test_password
POSTGRES_DB=herp_test
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Mock API Configuration (for isolated testing)
HERP_MOCK_API_URL=http://herp-mock-api:8001
NOTION_MOCK_API_URL=http://notion-mock-api:8002
USE_MOCK_APIS=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Rate Limiting (adjust for development)
HERP_RATE_LIMIT_REQUESTS=100
HERP_RATE_LIMIT_WINDOW=60
NOTION_RATE_LIMIT_REQUESTS=3
NOTION_RATE_LIMIT_WINDOW=1
